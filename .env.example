# Copy to .env and adjust. Never commit the real .env.

# --- Backend -----------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Local Docker MySQL (host port 3307) or a Postgres URL (e.g. Supabase).
# On Vercel/Supabase prefer the pooled connection string when available.
DATABASE_URL="postgresql://food_search:food_search@localhost:5432/food_search"

# Where the browser reaches the frontend. Used for Stripe redirect URLs and CORS.
FRONTEND_URL=http://localhost:3000

# Open Food Facts asks every client to identify itself.
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT="FoodProductSearch/1.0 (assignment; contact@example.com)"
OFF_TIMEOUT_MS=8000

# --- Stripe (test mode) ------------------------------------------------------
# Leave STRIPE_SECRET_KEY empty to run with the stubbed billing provider, which
# simulates Checkout locally so the app is fully usable without Stripe keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Frontend ----------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:4000
